{
  // Extend the Quickshell Omarchy menu with JSONC. See the stock comments:
  // IDs are object keys, parent inferred from the dotted id.
  //
  // Pintura: tema gerado a partir de pinturas (comando ~/.local/bin/painting-theme).
  "pintura": {"icon":"󰋩","label":"Pintura do tema","aliases":["pintura","paintings"],"description":"Wallpaper e cores a partir de uma pintura"},
  "pintura.next": {"icon":"󰑐","label":"Trocar agora","action":"painting-theme next"},
  "pintura.choose": {"icon":"󰉏","label":"Escolher pintura","action":"painting-theme choose"},
  "pintura.rating": {"icon":"󰔓","label":"Minha avaliação desta pintura","description":"Mude de ideia sobre o Gostei ou Não gostei"},
  "pintura.rating.like": {"icon":"󰔓","label":"Gostei","action":"painting-theme like >/dev/null","checked":"[ \"$(painting-theme rating)\" = 1 ]"},
  "pintura.rating.dislike": {"icon":"󰔑","label":"Não gostei","action":"painting-theme dislike >/dev/null","checked":"[ \"$(painting-theme rating)\" = -1 ]"},
  "pintura.rating.clear": {"icon":"󰆴","label":"Remover avaliação","action":"painting-theme unrate >/dev/null"},
  "pintura.clock": {"icon":"󰅐","label":"Relógio no desktop","action":"desktop-clock toggle","checked":"[ \"$(desktop-clock)\" = on ]"},
  "pintura.auto": {"icon":"󰔟","label":"Automático","action":"painting-theme config enabled $(painting-theme config | jq -r 'if .enabled then 0 else 1 end') >/dev/null","checked":"painting-theme config | jq -e .enabled >/dev/null"},
  "pintura.boot": {"icon":"󰐥","label":"Ao ligar o PC","action":"painting-theme config on_boot $(painting-theme config | jq -r 'if .on_boot then 0 else 1 end') >/dev/null","checked":"painting-theme config | jq -e .on_boot >/dev/null"},
  "pintura.wake": {"icon":"󰒲","label":"Ao acordar","action":"painting-theme config on_wake $(painting-theme config | jq -r 'if .on_wake then 0 else 1 end') >/dev/null","checked":"painting-theme config | jq -e .on_wake >/dev/null"},
  "pintura.bytime": {"icon":"󰖙","label":"Por horário","action":"painting-theme config by_time $(painting-theme config | jq -r 'if .by_time then 0 else 1 end') >/dev/null","checked":"painting-theme config | jq -e .by_time >/dev/null"},
  "pintura.interval": {"icon":"󰥔","label":"Trocar a cada…"},
  "pintura.interval.m30": {"label":"30 minutos","action":"painting-theme config interval_min 30 >/dev/null","checked":"[ $(painting-theme config | jq .interval_min) = 30 ]"},
  "pintura.interval.h1": {"label":"1 hora","action":"painting-theme config interval_min 60 >/dev/null","checked":"[ $(painting-theme config | jq .interval_min) = 60 ]"},
  "pintura.interval.h3": {"label":"3 horas","action":"painting-theme config interval_min 180 >/dev/null","checked":"[ $(painting-theme config | jq .interval_min) = 180 ]"},
  "pintura.interval.h6": {"label":"6 horas","action":"painting-theme config interval_min 360 >/dev/null","checked":"[ $(painting-theme config | jq .interval_min) = 360 ]"},
  "pintura.interval.off": {"label":"Nunca (só manual)","action":"painting-theme config interval_min 0 >/dev/null","checked":"[ $(painting-theme config | jq .interval_min) = 0 ]"}
}
