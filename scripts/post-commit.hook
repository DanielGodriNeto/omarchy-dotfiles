#!/bin/sh
# Hook versionado: nunca bloqueia o commit. Tudo em segundo plano, só AST (a camada semântica é sob demanda: STALE-SEMANTIC).
cd "$(git rev-parse --show-toplevel)" || exit 0
mkdir -p graphify-out
( scripts/map.sh
  if [ -f graphify-out/.graphify_python ]; then scripts/graph-refresh.sh; fi ) >graphify-out/refresh.log 2>&1 &
exit 0
