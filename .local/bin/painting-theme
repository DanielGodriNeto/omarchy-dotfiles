          ("portrait", ("portrait",)), ("stilllife", ("still life", "still-life", "flowers", "sunflower"))]

# Etiquetas por artista: estilos (varios) | tracos | regioes | epoca. Um quadro pode ter varios estilos.
ARTIST_TAGS = {
    "Caspar David Friedrich": "romantismo,simbolismo|dramatico,sereno|europa|s1800",
    "Joseph Mallord William Turner": "romantismo|dramatico,pictorico|europa|s1800",
    "John Constable": "romantismo,realismo|sereno,realista|europa|s1800",
    "Eugène Delacroix": "romantismo,orientalismo,historico|dramatico,pictorico|europa|s1800",
    "Ivan Aivazovsky": "romantismo,realismo|dramatico,realista|russia|s1800",
    "John Martin": "romantismo,fantasia|dramatico|europa|s1800",
    "Samuel Palmer": "romantismo,simbolismo|sereno,estilizado|europa|s1800",
    "Hans Gude": "romantismo,realismo|sereno,realista|nordica|s1800",
    "Alexandre Calame": "romantismo,realismo|dramatico,realista|europa|s1800",
    "Joseph Wright of Derby": "romantismo|dramatico,realista|europa|s1700",
    "Frederic Edwin Church": "hudson-river,romantismo|dramatico,realista|americas|s1800",
    "Albert Bierstadt": "hudson-river,romantismo|dramatico,realista|americas|s1800",
