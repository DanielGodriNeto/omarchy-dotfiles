]


def tags_from_artist(artist):
    spec = ARTIST_TAGS.get(artist or "")
    if not spec:
        return set()
    styles, traits, regions, epoch = spec.split("|")
    return ({f"estilo:{x}" for x in styles.split(",")} | {f"traco:{x}" for x in traits.split(",")}
            | {f"regiao:{x}" for x in regions.split(",")} | {f"epoca:{epoch}"})


def tags_from_text(text):
    import re
    low = " " + text.lower()
    out = {tag for tag, keys in TAG_KEYWORDS if any(k in low for k in keys)}
    for m in re.finditer(r"(\d{2})th-century", low):
        out.add(f"epoca:s{(int(m.group(1)) - 1) * 100}")
    for m in re.finditer(r"\b(1[5-9]\d\d)\b", low):
        out.add(f"epoca:s{int(m.group(1)) // 100 * 100}")
    return out


def dynamic_tags(ft):
    """Etiquetas que vem das cores: paleta (quente, fria, neutra) e luz (escura, media, clara)."""
    out = set()
    hue, lum = ft.get("hue"), ft.get("lum")
    if hue is not None:
        out.add("paleta:quente" if hue in ("11", "0", "1", "2") else "paleta:fria" if hue in ("5", "6", "7", "8", "9") else "paleta:neutra")
    if lum is not None:
        out.add("luz:escura" if lum in ("0", "1") else "luz:media" if lum == "2" else "luz:clara")
    return out


_TAGS_CACHE = None


def get_tags():
    global _TAGS_CACHE
    if _TAGS_CACHE is None:
        _TAGS_CACHE = load_json(TAGS, {}) if os.path.exists(TAGS) else {}
    return _TAGS_CACHE


def item_features(it, feats, meta):
    """Caracteristicas de uma pintura: autor, genero, categoria, cor, luminosidade e qualidade."""
    import re
    cat = it.get("c", "")
    out = {"cat": cat or None}
    m = re.search(r" by (.+)$", cat)
    out["artist"] = m.group(1).strip() if m else None
    low = cat.lower()
    out["genre"] = next((g for g, keys in GENRES if any(k in low for k in keys)), "landscape")
    ft = feats.get(it["f"], {})
    out["hue"] = ft.get("hue")
    out["lum"] = ft.get("lum")
    w = meta.get(it["f"], {}).get("w", 0)
    out["q"] = "hi" if w >= 3000 else "lo" if w else None
    out = {k: v for k, v in out.items() if v is not None}
    tags = set(get_tags().get(it["f"], [])) | dynamic_tags(out)
    if tags:
        out["tags"] = sorted(tags)
    return out


def cmd_features():
    """Matiz dominante (bins de 30 graus; 'gray' se pouca cor) e luminosidade (0-3) de cada pintura."""
    feats = load_json(FEATURES, {}) if os.path.exists(FEATURES) else {}
    lum = load_json(LUM, {}) if os.path.exists(LUM) else {}
    for it in items():
        f = it["f"]
        if f in feats:
            continue
        try:
            clusters = hue_clusters(sample_pixels(f"{ART}/{f}"))
        except Exception:
            continue
        hue = int(clusters[0][1] // 30) if clusters else "gray"
        feats[f] = {"hue": str(hue), "lum": str(min(3, int(lum.get(f, 0.4) * 4)))}
    save_json(FEATURES, feats)
    print(f"{len(feats)} pinturas com cores")


def feature_keys(ft, dims):
    """Chaves de peso de uma pintura para as dimensoes pedidas. 'tags' sozinho = todas as etiquetas; 'tags:tema' = so a faceta."""
    keys = []
    for dim in dims:
        if dim.startswith("tags"):
            facet = dim.partition(":")[2]
            keys += [f"tag:{t}" for t in ft.get("tags", []) if not facet or t.startswith(facet + ":")]
        elif dim in ft:
            keys.append(f"{dim}:{ft[dim]}")
    return keys


def cmd_tags():
    """Etiquetas fixas de cada pintura (estilos, tracos, tema, regiao, epoca): tabela de artistas/categorias + categorias do Commons."""
    import re
    tags = load_json(TAGS, {}) if os.path.exists(TAGS) else {}
    todo = [it for it in items() if it["f"] not in tags]
    base = {}
    for it in todo:
        cat = it.get("c", "")
        m = re.search(r" by (.+)$", cat)
        t = tags_from_artist(m.group(1).strip() if m else None) | tags_from_text(cat)
        for spec in CATEGORY_TAGS.get(cat, "").split():
            t.add(spec)
        base[it["f"]] = t
    print(f"{len(todo)} pinturas sem etiquetas; consultando as categorias de cada arquivo no Commons")
    for i in range(0, len(todo), 20):
        batch = todo[i:i + 20]
        cats, cont = {}, {}
        while True:
            q = urllib.parse.urlencode({"action": "query", "format": "json", "formatversion": "2", "prop": "categories",
                                        "cllimit": "max", "titles": "|".join(b["t"] for b in batch), **cont})
            req = urllib.request.Request(f"https://commons.wikimedia.org/w/api.php?{q}", headers={"User-Agent": UA})
            try:
                with urllib.request.urlopen(req, timeout=40) as r:
                    data = json.load(r)
            except Exception as e:
                print(f"lote {i} falhou: {e}", file=sys.stderr)
                time.sleep(10)
                break
            for page in data.get("query", {}).get("pages", []):
                cats.setdefault(page["title"], []).extend(c["title"].removeprefix("Category:") for c in page.get("categories", []))
            if "continue" not in data:
                break
            cont = data["continue"]
            time.sleep(2.5)
        for b in batch:
            extra = cats.get(b["t"], [])
            t = set(base[b["f"]]) | tags_from_text(" ".join(extra))
            for c in extra:
                m = re.search(r"(?:Paintings|Landscape paintings|Seascapes|Marine paintings) by (.+)$", c)
                if m:
                    t |= tags_from_artist(m.group(1).strip())
            tags[b["f"]] = sorted(t)
        save_json(TAGS, tags)
        time.sleep(4)
    count = {}
    for ts in tags.values():
        for t in ts:
            count[t] = count.get(t, 0) + 1
    print(f"{len(tags)} pinturas com etiquetas; {len(count)} etiquetas distintas")


def cmd_niches():
    """Combinacoes de etiquetas que mais aparecem no que voce gostou, comparadas com o acervo todo (lift)."""
    import itertools
    ratings = load_json(TASTE, {"ratings": {}}).get("ratings", {})
    feats = load_json(FEATURES, {}) if os.path.exists(FEATURES) else {}
    meta = load_json(META, {}) if os.path.exists(META) else {}
    pool, _ = eligible()
    def tagset(it):
        return set(item_features(it, feats, meta).get("tags", []))
    pool_sets = [tagset(it) for it in pool]
    by_f = {it["f"]: it for it in items()}
    liked = [tagset(by_f[f]) for f, r in ratings.items() if r.get("v") == 1 and f in by_f]
    disliked = [tagset(by_f[f]) for f, r in ratings.items() if r.get("v") == -1 and f in by_f]
    if not liked or not pool_sets:
        sys.exit("sem avaliacoes positivas ou sem acervo")
    def stats(combo):
        in_pool = sum(1 for t in pool_sets if combo <= t) / len(pool_sets)
        in_like = sum(1 for t in liked if combo <= t) / len(liked)
        in_dis = sum(1 for t in disliked if combo <= t) / len(disliked) if disliked else 0.0
        return in_pool, in_like, in_dis
    tags = sorted({t for ts in liked for t in ts})
    rows = []
    for size in (1, 2, 3):
        for combo in itertools.combinations(tags, size):
            if len({c.split(":")[0] for c in combo}) < size and size > 1:
                continue  # uma combinacao mistura facetas diferentes (estilo + tema + ...)
            c = set(combo)
            pp, pl, pd = stats(c)
            if pp * len(pool_sets) < 15 or pl * len(liked) < 4:
                continue
            rows.append({"combo": list(combo), "no_acervo": round(pp, 3), "no_que_gostou": round(pl, 3),
                         "lift": round(pl / pp, 2), "no_que_nao_gostou": round(pd, 3)})
    rows = sorted(rows, key=lambda r: (r["lift"] * (1 - r["no_que_nao_gostou"]), r["no_que_gostou"]), reverse=True)
    print(json.dumps({"avaliadas_positivas": len(liked), "avaliadas_negativas": len(disliked), "nichos": rows[:15]}, ensure_ascii=False, indent=1))


def taste_model():
    """Pesos por caracteristica, recalculados das avaliacoes (reavaliar substitui a nota anterior)."""
    ratings = load_json(TASTE, {"ratings": {}}).get("ratings", {})
    feats = load_json(FEATURES, {}) if os.path.exists(FEATURES) else {}
    meta = load_json(META, {}) if os.path.exists(META) else {}
    by_f = {it["f"]: it for it in items()}
    weights, seen = {}, {}
    for f, r in ratings.items():
        it = by_f.get(f)
        if not it or r.get("v") not in (1, -1):
            continue
        ft = item_features(it, feats, meta)
        for k in feature_keys(ft, r.get("dims", [])):
            weights[k] = weights.get(k, 0) + r["v"]
        for k in feature_keys(ft, ("artist", "genre", "cat", "tags:estilo", "tags:tema")):
            seen[k] = seen.get(k, 0) + 1
    return weights, seen


def item_weight(it, weights, seen, explore, feats, meta):
    import math
    ft = item_features(it, feats, meta)
    if explore:
        keys = feature_keys(ft, ("artist", "genre", "cat", "tags:estilo", "tags:tema"))
        return 1.0 / (1 + sum(seen.get(k, 0) for k in keys))
    plain = feature_keys(ft, [d for d in ft if d != "tags"])
    tag_keys = feature_keys(ft, ("tags",))
    score = sum(weights.get(k, 0) for k in plain)
    if tag_keys:  # a media das etiquetas, para uma pintura com muitas etiquetas nao pesar mais so por isso
        score += 3.0 * sum(weights.get(k, 0) for k in tag_keys) / len(tag_keys)
    return math.exp(0.5 * max(-6, min(6, score)))


def weighted_order(pool):
    """Ordem sorteada com peso (Efraimidis-Spirakis): quanto maior o peso, mais perto do inicio."""
    weights, seen = taste_model()
    feats = load_json(FEATURES, {}) if os.path.exists(FEATURES) else {}
    meta = load_json(META, {}) if os.path.exists(META) else {}
    explore = random.random() < EXPLORE
    keyed = [(random.random() ** (1.0 / item_weight(it, weights, seen, explore, feats, meta)), it) for it in pool]
    return [it for _, it in sorted(keyed, key=lambda x: x[0], reverse=True)]


def cmd_rate(value, reasons):
    cur = load_json(STATE, {}).get("current")
    if not cur:
        sys.exit("sem pintura atual")
    bad = [r for r in reasons if r not in DIMS and r != "imagem"]
    if bad:
        sys.exit(f"motivo desconhecido: {bad}")
    only_image = "imagem" in reasons
    dims = [d for r in reasons if r in DIMS for d in DIMS[r]]
    if not reasons:  # sem motivo: tudo que descreve a pintura, menos a qualidade do arquivo
        dims = [d for k, ds in DIMS.items() if k != "qualidade" for d in ds]
    data = load_json(TASTE, {"ratings": {}})
    if only_image and value == -1:
        data["ratings"].pop(cur, None)
        prev = excluded()
        if cur not in prev:
            with open(f"{ART}/exclude.txt", "a") as f:
                f.write(("\n" if prev and not open(f"{ART}/exclude.txt").read().endswith("\n") else "") + cur + "\n")
    else:
        data["ratings"][cur] = {"v": value, "dims": dims, "ts": int(time.time())}
    save_json(TASTE, data)
    for stale in (NEXT_JSON, NEXT_JPG):  # a escolha ja baixada foi feita com o gosto antigo
        if os.path.exists(stale):
            os.remove(stale)
    print(json.dumps({"current": cur, "v": value, "dims": dims, "excluded": only_image and value == -1}))


def cmd_taste():
    weights, seen = taste_model()
    ranked = sorted(weights.items(), key=lambda kv: kv[1], reverse=True)
    print(json.dumps({"likes": ranked[:8], "dislikes": [kv for kv in ranked[::-1] if kv[1] < 0][:8],
                      "ratings": len(load_json(TASTE, {"ratings": {}})["ratings"])}, ensure_ascii=False))


def pick_pool():
    good, _ = eligible()
    state = load_json(STATE, {"recent": []})
    recent = set(state.get("recent", []))
    base = good
    if load_json(CFG, DEFAULTS).get("by_time"):
        base = band_pool(good) or good
    pool = [it for it in base if it["f"] not in recent] or base or items()
    return weighted_order(pool)


NEXT_JSON = f"{CACHE_DIR}/next.json"
NEXT_JPG = f"{CACHE_DIR}/next.jpg"


def cmd_prefetch():
    """Deixa a proxima pintura baixada e cortada, para a troca ser instantanea."""
    lock = open(f"{CACHE_DIR}/prefetch.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    item = pick_pool()[0]
    _, meta = eligible()
    prepare(item, meta, NEXT_JPG)
    save_json(NEXT_JSON, {**item, "band": current_band()[1]})


def start_prefetch():
    subprocess.Popen([sys.argv[0], "prefetch"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def cmd_next():
    ready = load_json(NEXT_JSON, {}) if os.path.exists(NEXT_JSON) else {}
    stale = load_json(CFG, DEFAULTS).get("by_time") and ready.get("band") != current_band()[1]
    if ready.get("f") and os.path.exists(NEXT_JPG) and not stale:
        os.remove(NEXT_JSON)
        apply(ready, ready=NEXT_JPG)
    else:
        apply(pick_pool()[0])
    start_prefetch()


def cmd_pick(f):
    it = next((i for i in items() if i["f"] == f), None)
    if not it:
        sys.exit(f"pintura {f} nao encontrada")
    apply(it)


# ---------- daemon ----------

def seconds_since_change():
    return time.time() - load_json(STATE, {}).get("changed", 0)


_pending = None


def change_if_allowed(reason):
    cfg = load_json(CFG, DEFAULTS)
    if not cfg["enabled"] or seconds_since_change() < cfg["min_gap_min"] * 60:
        return
    if peek_state():  # vendo o desktop (Super+D): espera sair do peek e troca depois
        global _pending
        _pending = reason
        return
    print(f"trocando pintura ({reason})", flush=True)
    cmd_next()


def cmd_daemon():
    cfg = load_json(CFG, DEFAULTS)
    if cfg["on_boot"]:
        time.sleep(20)  # espera o shell subir
        change_if_allowed("login")
    watcher = subprocess.Popen(
        ["dbus-monitor", "--system", "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"],
        stdout=subprocess.PIPE, text=True, bufsize=1)
    import selectors
    sel = selectors.DefaultSelector()
    sel.register(watcher.stdout, selectors.EVENT_READ)
    while True:
        cfg = load_json(CFG, DEFAULTS)
        global _pending
        if _pending and not peek_state():
            reason, _pending = _pending, None
            change_if_allowed(reason)
        for _ in sel.select(timeout=30):
            line = watcher.stdout.readline()
            if "boolean false" in line and cfg["on_wake"]:
                time.sleep(8)  # rede e shell voltam do sleep
                change_if_allowed("acordou")
        if cfg["enabled"] and cfg.get("by_time") and load_json(STATE, {}).get("band") != current_band()[1]:
            change_if_allowed("faixa do dia")
        elif cfg["enabled"] and cfg["interval_min"] > 0 and seconds_since_change() >= cfg["interval_min"] * 60:
            change_if_allowed("tempo")
        if watcher.poll() is not None:
            sys.exit("dbus-monitor terminou")


def cmd_choose():
    """Abre o seletor de imagens do Omarchy com as pinturas e aplica a escolhida."""
    import re, shutil
    gal = f"{STATE_DIR}/gallery"
    shutil.rmtree(gal, ignore_errors=True)
    os.makedirs(gal)
    for it in eligible()[0]:
        name = re.sub(r"[^\w .,'()-]", "", it["t"].removeprefix("File:").rsplit(".", 1)[0])[:60].strip()
        os.symlink(f"{ART}/{it['f']}", f"{gal}/{name} [{it['f'][:-4]}].jpg")
    out = subprocess.run(["omarchy", "menu", "images", "--print-name", "--filterable", "--show-labels",
                          "--lazy-thumbnails", gal], capture_output=True, text=True).stdout.strip()
    m = re.search(r"\[(\d+)\]", out)
    if m:
        cmd_pick(f"{m.group(1)}.jpg")


def cmd_status():
    s = load_json(STATE, {"recent": []})
    s["config"] = load_json(CFG, DEFAULTS)
    cur = next((i for i in items() if i["f"] == s.get("current")), None)
    if cur:
        s["features"] = item_features(cur, load_json(FEATURES, {}) if os.path.exists(FEATURES) else {},
                                      load_json(META, {}) if os.path.exists(META) else {})
        s["rating"] = load_json(TASTE, {"ratings": {}})["ratings"].get(cur["f"])
    print(json.dumps(s, ensure_ascii=False))


def cmd_rating():
    """Nota da pintura atual: 1 (gostei), -1 (nao gostei) ou 0."""
    cur = load_json(STATE, {}).get("current")
    print((load_json(TASTE, {"ratings": {}})["ratings"].get(cur) or {}).get("v", 0))


def cmd_unrate():
    """Remove a nota da pintura atual (mudei de ideia)."""
    cur = load_json(STATE, {}).get("current")
    data = load_json(TASTE, {"ratings": {}})
    data["ratings"].pop(cur, None)
    save_json(TASTE, data)
    print(json.dumps({"current": cur, "v": 0}))


def cmd_config(args):
    cfg = load_json(CFG, DEFAULTS)
    if len(args) == 2:
        k, v = args
        if k not in DEFAULTS:
            sys.exit(f"chave desconhecida: {k}")
        cfg[k] = (v.lower() in ("1", "true", "on", "yes")) if isinstance(DEFAULTS[k], bool) else int(v)
        save_json(CFG, cfg)
    print(json.dumps(cfg))


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd in ("next", "pick"):
        lock = open(f"{STATE_DIR}/lock", "w")
        fcntl.flock(lock, fcntl.LOCK_EX)
        cmd_next() if cmd == "next" else cmd_pick(sys.argv[2])
    elif cmd == "flush-reload":
        os.makedirs(CACHE_DIR, exist_ok=True)
        cmd_flush_reload()
    elif cmd == "peek-guard":
        cmd_peek_guard()
    elif cmd == "lum":
        cmd_lum()
    elif cmd == "features":
        cmd_features()
    elif cmd in ("like", "dislike"):
        cmd_rate(1 if cmd == "like" else -1, sys.argv[2:])
    elif cmd == "tags":
        cmd_tags()
    elif cmd == "niches":
        cmd_niches()
    elif cmd == "rating":
        cmd_rating()
    elif cmd == "unrate":
        cmd_unrate()
    elif cmd == "taste":
        cmd_taste()
    elif cmd == "meta":
        cmd_meta()
    elif cmd == "prefetch":
        os.makedirs(CACHE_DIR, exist_ok=True)
        cmd_prefetch()
    elif cmd == "choose":
        cmd_choose()
    elif cmd == "status":
        cmd_status()
    elif cmd == "config":
        cmd_config(sys.argv[2:])
    elif cmd == "daemon":
        cmd_daemon()
    else:
        sys.exit(__doc__)


main()
