#!/usr/bin/env python3
"""Cores do papel de parede atual para as carpas do lago (mancato.lake), tiradas de pontos diferentes
da pintura: agrupa os pixels em 18 famílias de cor (k-means com sementes bem espalhadas, para as cores
raras sobreviverem) e devolve as que se distinguem entre si. Saída: JSON [[r, g, b], ...]. Guarda o resultado em ~/.cache/lake-palette/."""
import hashlib, json, os, subprocess, sys

import numpy as np

W, H = 100, 60
CACHE = os.path.expanduser("~/.cache/lake-palette")


def kmeans(px, k, rounds=12):
    rng = np.random.default_rng(1)
    cent = [px[rng.integers(len(px))]]
    for _ in range(k - 1):  # k-means++ seeding: far-away colours first, so rare ones (a sky, a red coat) survive
        d = np.min([((px - c) ** 2).sum(1) for c in cent], axis=0)
        cent.append(px[rng.choice(len(px), p=d / d.sum())] if d.sum() > 0 else px[0])
    cent = np.array(cent)
    for _ in range(rounds):
        lab = ((px[:, None, :] - cent[None]) ** 2).sum(2).argmin(1)
        for i in range(k):
            if (lab == i).any():
                cent[i] = px[lab == i].mean(0)
    return cent, np.bincount(lab, minlength=k)


def regional_colors(path):
    raw = subprocess.run(["magick", path, "-resize", f"{W}x{H}!", "-depth", "8", "rgb:-"], capture_output=True, check=True).stdout
    px = np.frombuffer(raw, dtype=np.uint8).reshape(-1, 3).astype(np.float32)
    cent, counts = kmeans(px, 18)
    out = []
    for i in np.argsort(-counts):
        col = [int(v) for v in cent[i]]
        if all(sum((a - b) ** 2 for a, b in zip(col, o)) > 28 ** 2 for o in out):
            out.append(col)
    return out


def main():
    path = os.path.realpath(os.path.expanduser("~/.local/state/omarchy/current/background"))
    if not os.path.isfile(path):
        print("[]")
        return
    key = hashlib.sha1(f"{path}:{os.path.getmtime(path)}".encode()).hexdigest()
    cache = os.path.join(CACHE, key + ".json")
    if os.path.isfile(cache):
        print(open(cache).read())
        return
    try:
        colors = regional_colors(path)
    except (subprocess.CalledProcessError, ValueError, OSError):
        print("[]")
        return
    os.makedirs(CACHE, exist_ok=True)
    with open(cache, "w") as f:
        json.dump(colors, f)
    print(json.dumps(colors))


main()
