#!/usr/bin/env python3
"""fastfetch adaptativo: ajusta imagem e secoes ao tamanho do terminal."""
import json, os, shutil, tomllib, subprocess, sys, tempfile

IMG = os.path.expanduser("~/.config/fastfetch/logo.png")
PEACH, TEAL, GREY = "#d39d8b", "#688894", "#66737a"
DARK = ["#3a2a36", "#d08a86", "#9fb99a", "#dcc08f", "#7f9fb8", "#b496b8", "#86b3b8", "#dad1d0"]
LIGHT = ["#5a4a56", "#e8a9a3", "#bcd4b4", "#ecd7aa", "#a3bdd2", "#cdb3d2", "#a6cdd0", "#f4eeed"]
GREEN, YELLOW, RED = "#9fb99a", "#dcc08f", "#d08a86"
THEME_FILE = os.path.expanduser("~/.local/state/omarchy/current/theme/colors.toml")

def mix(a, b, t):
    """Mistura a->b; t=0 devolve a, t=1 devolve b."""
    ca = [int(a[i:i + 2], 16) for i in (1, 3, 5)]
    cb = [int(b[i:i + 2], 16) for i in (1, 3, 5)]
    return "#%02x%02x%02x" % tuple(round(x + (y - x) * t) for x, y in zip(ca, cb))

def load_theme():
    """Acento nos titulos e barras, chaves neutras, ANSI do tema nas amostras."""
    global PEACH, TEAL, GREY, DARK, LIGHT, GREEN, YELLOW, RED
    try:
        with open(THEME_FILE, "rb") as f:
            c = tomllib.load(f)
        fg, bgc = c["foreground"], c["background"]
        PEACH = c["accent"]
        TEAL = mix(bgc, fg, 0.7)
        GREY = mix(c["muted"], fg, 0.3)
        names = ["red", "green", "yellow", "blue", "magenta", "cyan"]
        DARK = [c["darker_background"]] + [c[n] for n in names] + [fg]
        LIGHT = [c["lighter_background"]] + [c["bright_" + n] for n in names] + [c["bright_foreground"]]
        GREEN, YELLOW, RED = c["green"], c["yellow"], c["red"]
    except (OSError, KeyError, ValueError):
        pass

INFO_W = 78  # largura da coluna de texto da versao escolhida
KEY_COL = 16  # valores sao alinhados na coluna 16
MIN_LOGO = 12
PAD = 3

def rgb(h): return "38;2;%d;%d;%d" % tuple(int(h[i:i+2], 16) for i in (1, 3, 5))
def bg(h): return "{#48;2;%d;%d;%d}" % tuple(int(h[i:i+2], 16) for i in (1, 3, 5))
def swatch(cols): return {"type": "custom", "key": " ", "format": "".join(bg(c) + "   " for c in cols) + "{#}"}
OVERRIDES = {
    "cpuusage": {"key": "CPU Usage"}, "disk": {"key": "Disk"}, "battery": {"key": "Battery"},
    "display": {"key": "Display"}, "localip": {"key": "Local IP"}, "wifi": {"key": "Wi-Fi",
        "format": "{ssid} - {band} GHz - {security}"},
    "host": {"format": "{name}"}, "sound": {"format": "{name}"},
    "cpu": {"format": "{name} @ {freq-max}"},
}

def mod(t): return {"type": t, **OVERRIDES.get(t, {})}
def brk(): return mod("break")

def header(name):
    return {"type": "custom", "key": " ", "format": "{#1;%s}ⓘ %s{#}" % (rgb(PEACH), name)}

def section(name, types):
    return [header(name)] + [mod(t) for t in types] + [brk()]

USO = ["cpuusage", "memory", "swap", "disk", "battery"]

def tiers():
    top = [{"type": "custom", "key": " ", "format": "{#%s}╺━━━━━━━━━  ⚡  ━━━━━━━━━╸{#}" % rgb(GREY)},
           mod("title"),
           {"type": "command", "key": " ", "text": "date '+%d-%m-%Y %H:%M'"}, brk()]
    head = top
    both = [swatch(DARK), swatch(LIGHT)]
    yield "completo", head + section("Software Info", ["os", "kernel", "uptime", "packages", "shell", "de", "wm"]) \
        + section("Eyecandy", ["theme", "icons", "font", "cursor", "terminal", "terminalfont"]) \
        + section("Guts", ["host", "display", "cpu", "gpu"]) \
        + section("Meters", USO) \
        + section("Interweb", ["wifi", "localip"]) \
        + section("Sound", ["sound"]) + both
    yield "medio", head + section("Software Info", ["os", "kernel", "uptime", "packages", "shell"]) \
        + section("Eyecandy", ["theme", "terminal"]) \
        + section("Guts", ["cpu", "gpu"]) \
        + section("Meters", USO) + both
    yield "compacto", head[:2] + [brk()] + section("Software Info", ["os", "kernel", "uptime"]) \
        + section("Guts", ["cpu", "gpu"]) \
        + section("Meters", ["memory", "disk", "battery"]) + [swatch(DARK)]
    yield "minimo", head[:2] + [brk()] + [mod(t) for t in ["os", "cpu", "memory", "disk", "battery"]] + [swatch(DARK)]
    yield "micro", [mod(t) for t in ["title", "memory", "battery"]]

def build(modules, logo):
    return {
        "logo": logo,
        "display": {
            "key": {"type": "both", "width": 16},
            "separator": "▶  ",
            "color": {"keys": rgb(TEAL), "title": rgb(PEACH), "separator": rgb(GREY)},
            "percent": {"type": 3, "color": {"green": rgb(GREEN), "yellow": rgb(YELLOW), "red": rgb(RED)}},
            "bar": {"char": {"elapsed": "▰", "total": "▱"}, "width": 10,
                    "color": {"elapsed": rgb(PEACH), "total": rgb(GREY)}},
        },
        "modules": modules,
    }

def run(cfg, extra):
    with tempfile.NamedTemporaryFile("w", suffix=".jsonc", delete=False) as f:
        json.dump(cfg, f)
    try:
        return subprocess.run(["fastfetch", "--config", f.name, *extra], capture_output=True, text=True)
    finally:
        os.unlink(f.name)

def text_width(line):
    """Largura visivel: valores comecam na coluna KEY_COL (escape \\x1b[16G)."""
    head, sep, value = line.partition("\x1b[16G")
    return KEY_COL + len(value) if sep else len(line)

def measure(modules):
    """(linhas, largura aproximada) do texto de uma versao, sem logo."""
    out = run(build(modules, {"type": "none"}), ["--pipe", "true"]).stdout.rstrip("\n").split("\n")
    return len(out), max(text_width(line) for line in out)

def logo_config(width, cols, info_lines):
    region = cols - INFO_W - PAD
    left = max(0, (region - width) // 2)
    height = width // 2
    return {"type": "sixel", "source": IMG, "width": width, "height": height,
            "padding": {"left": left, "right": PAD + max(0, region - width - left),
                        "top": max(0, (info_lines - height) // 2)}}

def main():
    load_theme()
    size = shutil.get_terminal_size((100, 40))
    cols, lines = size.columns, size.lines
    limit = lines - 1  # sobra uma linha para o prompt
    sizes = [(name, mods, *measure(mods)) for name, mods in tiers() if name != "micro"]
    biggest = min(cols // 2, 2 * (lines - 2))  # alvo: metade da largura do terminal
    chosen, logo = None, {"type": "none"}
    # imagem tem prioridade: tenta o maior tamanho e escolhe o texto mais completo que cabe ao lado
    for width in range(biggest, MIN_LOGO - 1, -2):
        if not os.path.exists(IMG):
            break
        fit = [t for t in sizes if t[2] <= limit and t[3] <= cols - width - PAD]
        if fit:
            global INFO_W
            INFO_W = fit[0][3]
            chosen, logo = fit[0][1], logo_config(width, cols, fit[0][2])
            break
    if chosen is None:
        chosen = [mod(t) for t in ["title", "memory", "battery"]]
    os.execvp("fastfetch", ["fastfetch", "--config", write(build(chosen, logo))] + sys.argv[1:])

def write(cfg):
    path = os.path.join(tempfile.gettempdir(), "ff-%d.jsonc" % os.getuid())
    with open(path, "w") as f:
        json.dump(cfg, f)
    return path

if __name__ == "__main__":
    main()
